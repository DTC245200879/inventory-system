# Sao chép thành .env rồi thay bằng mật khẩu mạnh
#   (hoặc chạy: bash scripts/gen-env.sh để sinh tự động)
# Mật khẩu chỉ nên gồm chữ + số, >= 16 ký tự.
MYSQL_ROOT_PASSWORD=change_me_root_32chars_xxxxxxxxxxxx
APP_DB_USER=inventory_app
APP_DB_PASSWORD=change_me_app_24chars_xxxxx
EXPORTER_DB_PASSWORD=change_me_exporter_24chars_x
SECRET_KEY=change_me_long_random_string_48_chars_xxxxxxxxxxx
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_admin_pw
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana_pw
# Địa chỉ truy cập từ trình duyệt (đổi thành https://localhost:8443 nếu dùng cổng 8443)
PUBLIC_URL=https://localhost
